{
  "name": "cms",
  "version": "1.0.0",
  "description": "Enterprise CMS Admin Starter powered by Next.js 16 + Ant Design 6 + TanStack Query + CASL",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev --turbo -p 3333",
    "build": "next build --webpack",
    "start": "next start -p 3333",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "gen:crud": "node ../tools/generator/gen-slice.mjs",
    "gen:feat": "node ../tools/generator/gen-slice.mjs"
  },
  "dependencies": {
    "@ant-design/icons": "6",
    "@ant-design/nextjs-registry": "1.3.0",
    "@casl/ability": "6.7.5",
    "@repo/contracts": "*",
    "@tanstack/react-query": "5.90.10",
    "antd": "6",
    "clsx": "2.1.1",
    "dayjs": "1.11.19",
    "js-cookie": "3.0.8",
    "lucide-react": "0.552.0",
    "next": "16.2.6",
    "next-intl": "4.9.2",
    "nuqs": "^2.9.3",
    "qs": "6.15.2",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "server-only": "^0.0.1",
    "socket.io-client": "^4.8.3",
    "styled-components": "6.1.19",
    "tailwind-merge": "3.3.1",
    "zustand": "5.0.9"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "4",
    "@types/js-cookie": "3.0.6",
    "@types/node": "20",
    "@types/qs": "6.14.0",
    "@types/react": "19",
    "@types/react-dom": "19",
    "@vitest/coverage-v8": "4.1.4",
    "eslint": "9",
    "eslint-config-next": "16.2.4",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.0.1",
    "postcss": "8.5.10",
    "prettier": "3.6.2",
    "prettier-plugin-organize-imports": "4.3.0",
    "prettier-plugin-tailwindcss": "0.7.1",
    "tailwindcss": "4",
    "typescript": "5",
    "typescript-eslint": "8.46.4",
    "vitest": "4.1.4"
  }
}
