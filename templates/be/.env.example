# ─────────────────────────────────────────────────────────────────────────────
# Application
# ─────────────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# ─────────────────────────────────────────────────────────────────────────────
# Swagger UI (set SWAGGER_ENABLED=false to disable in production)
# ─────────────────────────────────────────────────────────────────────────────
SWAGGER_ENABLED=true
SWAGGER_PATH=docs
SWAGGER_TITLE=NestJS Enterprise API
SWAGGER_VERSION=1.0.0

# Optional: Full URL of your reverse proxy / API gateway (e.g. https://api.yourapp.com)
# APP_URL=https://api.yourapp.com

# ─────────────────────────────────────────────────────────────────────────────
# CORS (comma-separated allowed origins)
# ─────────────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:3333,http://localhost:3848

# ─────────────────────────────────────────────────────────────────────────────
# Security & Authentication
# JWT_SECRET: Secret key for signing access tokens (REQUIRED, min 32 characters)
# JWT_REFRESH_SECRET: Secret key for signing refresh tokens (REQUIRED, min 32 characters)
# Generate: openssl rand -hex 32
# ─────────────────────────────────────────────────────────────────────────────
JWT_SECRET=e7b4c91d84f26b52a1975e921d4c7836b8e3a241972b904d9c7e3f8a1205647b
JWT_REFRESH_SECRET=a8f3b2075c94e1832d561a7e49c0892f3b7d14e5920c4871e6a3502847d9c105

# BlindIndexUtil: HMAC-SHA256 secret for PII blind-indexing (ADR-005)
# Generate: openssl rand -hex 32
# ─────────────────────────────────────────────────────────────────────────────
BLIND_INDEX_SECRET=change_me_generate_with_openssl_rand_hex_32

# ─────────────────────────────────────────────────────────────────────────────
# Database (add your ORM config here when integrating TypeORM / Prisma)
# ─────────────────────────────────────────────────────────────────────────────
# DATABASE_URL=postgresql://user:password@localhost:5432/mydb
# DATABASE_SSL=false

