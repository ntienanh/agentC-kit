# Dependencies
node_modules/
.pnp
.pnp.js
.pnp.*

# Yarn Berry
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz
.yarn/global

# Build Outputs & Bundles
.next/
dist/
build/
out/
.turbo/
*.tsbuildinfo

# Environment & Secrets
.env
.env.local
.env.*.local
.env.development.local
.env.test.local
.env.production.local
!.env.example

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS & Editor Artifacts
.DS_Store
Thumbs.db
*.swp
*.swo

# Testing & Coverage Reports
coverage/
test-results/
playwright-report/
blob-report/
.nyc_output/
